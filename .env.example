# MarketEase / MarketLink Express.js Backend Environment Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/AptechDB2

# API Keys (Protected Routes x-api-key header)
API_KEY=your_api_key_here
MARKETEASE_API_KEY=your_marketease_api_key_here

# JWT Secret for Customer Authentication
JWT_SECRET=your_jwt_secret_key_here

# Stripe Payment Gateway
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Allowed CORS Origins
CLIENT_URL=http://localhost:3001
CLIENT_URL_ALT=http://localhost:3000
